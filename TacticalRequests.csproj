<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;dist/**</DefaultItemExcludes>
    <GameDirectory Condition="'$(GameDirectory)' == ''">E:/SteamLibrary/steamapps/common/Slay the Spire 2</GameDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'EnableSoloTesting' == 'true'">
    <DefineConstants>$(DefineConstants);TACTICAL_SOLO_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Reference Include="sts2" HintPath="$(GameDirectory)/data_sts2_windows_x86_64/sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(GameDirectory)/data_sts2_windows_x86_64/GodotSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDirectory)/data_sts2_windows_x86_64/0Harmony.dll" Private="false" />
  </ItemGroup>
</Project>
